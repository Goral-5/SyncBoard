# 1. DATABASE CONFIGURATION
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/syncboard?retryWrites=true&w=majority

# 2. SERVER PORT
PORT=5000

# 3. JWT AUTHENTICATION (Minimum 32 characters)
JWT_SECRET=your-strong-secret-key-change-in-production

# 4. CLOUDINARY CONFIGURATION (Optional - for canvas image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 5. GOOGLE OAUTH CONFIGURATION (Optional - for Google Sign-in)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 6. EMAIL NOTIFICATION / COLLABORATOR INVITES (Optional)
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_gmail_app_password
