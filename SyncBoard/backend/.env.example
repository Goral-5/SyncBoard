# =========================================================================
# SyncBoard Backend Environment Template (Rename to .env)
# =========================================================================

# 1. DATABASE CONFIGURATION
MONGO_URI=mongodb://localhost:27017/syncboard

# 2. SERVER PORT
PORT=5000

# 3. JWT AUTHENTICATION
JWT_SECRET=replace_this_with_a_secure_random_string

# 4. CLOUDINARY CONFIGURATION (Optional - for canvas image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 5. GOOGLE OAUTH CONFIGURATION (Optional - for Google Sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 6. EMAIL NOTIFICATION / COLLABORATOR INVITES (Optional)
GMAIL_USER=
GMAIL_PASS=
